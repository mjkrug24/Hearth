{
  "name": "hearth-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/model.test.js tests/api.test.js tests/planning.test.js tests/offline.test.js tests/household.test.js tests/pocketbase.test.js tests/household-store.test.js",
    "test:browser": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/capture-ui.mjs",
    "setup:pb": "node scripts/setup-pocketbase.mjs",
    "test:pb": "node scripts/test-pocketbase.mjs",
    "test:pb:legacy": "node scripts/test-pocketbase.mjs --legacy"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
