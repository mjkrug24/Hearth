PORT=3000
APP_BASE_URL=http://localhost:3000
# Production on Vercel: APP_BASE_URL=https://hearth.krugcloud.com
# Google authorized redirect URI: https://hearth.krugcloud.com/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
TOKEN_ENCRYPTION_KEY=use-a-long-random-value-unique-to-this-app
# Household storage uses the PocketBase URL in advanced Hearth account settings.
# These legacy settings apply only to an older Google/Supabase migration deployment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HOUSEHOLD_MEMBERS=
HOUSEHOLD_ID=home
